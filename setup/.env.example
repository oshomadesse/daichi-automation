# ============================================
# 以下の値を自分の環境に合わせて変更してください
# ============================================

# ---------- Google Cloud ----------
# OAuthクライアントのJSONキーファイル（変更不要）
GOOGLE_CLIENT_SECRET_FILE=credentials/client_secret.json

# Google DriveフォルダのID
# DriveでフォルダURLの最後の部分: https://drive.google.com/drive/folders/【ここのID】
GOOGLE_DRIVE_FOLDER_ID=ここにDriveフォルダIDを貼り付け

# GoogleスプレッドシートのID
# スプシURLの中間部分: https://docs.google.com/spreadsheets/d/【ここのID】/edit
GOOGLE_SPREADSHEET_ID=ここにスプレッドシートIDを貼り付け

# ---------- Gmail ----------
# 送信元Gmailアドレス
GMAIL_ADDRESS=ここに自分のGmailアドレス

# Gmailアプリパスワード（16文字、スペース付き）
GMAIL_APP_PASSWORD=ここにアプリパスワード

# 通知先メールアドレス（自分宛ならGMAIL_ADDRESSと同じでOK）
NOTIFY_TO=ここに通知先メールアドレス
